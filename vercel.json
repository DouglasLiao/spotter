{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "VITE_API_BASE_URL=/api npm run build",
      "devCommand": "VITE_API_BASE_URL=/api npm run dev -- --port $PORT",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend/",
      "framework": "django",
      "entrypoint": "core.wsgi:application",
      "functions": {
        "core/wsgi.py": {
          "maxDuration": 180,
          "excludeFiles": "{venv/**,.venv/**,routing/tests/**,**/__pycache__/**,*.sqlite3}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "backend" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/admin", "destination": { "service": "backend" } },
    { "source": "/admin/(.*)", "destination": { "service": "backend" } },
    { "source": "/static", "destination": { "service": "backend" } },
    { "source": "/static/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
